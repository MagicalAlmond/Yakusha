{
  "name": "yakusha",
  "version": "0.12.0",
  "description": "Non-invasive runtime translation toolkit for RPG Maker MZ, RPG Maker MV, RPG Maker XP/VX/VX Ace (RGSS) and Ren'Py games",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "yakusha": "./bin/yakusha.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "lint": "node --check bin/yakusha.js"
  },
  "keywords": [
    "rpg-maker",
    "rpgmaker-mz",
    "rpgmaker-mv",
    "rpgmaker-xp",
    "rpgmaker-vx",
    "rgss",
    "renpy",
    "translation",
    "localization",
    "llm",
    "translation-audit",
    "glossary",
    "consistency",
    "filtering",
    "traditional-chinese",
    "quality-assurance",
    "speaker-names",
    "report",
    "diagnostics"
  ],
  "license": "GPL-3.0-or-later",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ]
}
